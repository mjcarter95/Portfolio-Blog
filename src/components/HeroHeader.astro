---
export interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  date?: Date;
  readTime?: number;
  tags?: string[];
  series?: string;
  series_order?: number;
}

import { slugifyTag } from "@/utils/tags";
const { title, subtitle, date, readTime, tags, series, series_order } = Astro.props;
---

<header class="page-head">
  <div class="page-head-inner">
    <div class="page-head-row">
      <div>
        <h1 class="page-title">{title}</h1>
        {subtitle && <p class="page-sub">{subtitle}</p>}

        {(date || readTime || (tags && tags.length > 0) || series) && (
          <div class="page-meta">
            {date && (
              <time datetime={date.toISOString()}>
                {date.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "long",
                  day: "2-digit",
                })}
              </time>
            )}
            {readTime && <span>· {readTime} min read</span>}
            {series && (
              <>
                <span aria-hidden="true">·</span>
                <a href={`/series/${slugifyTag(series)}/`} class="meta-link">
                  Part {series_order}: {series}
                </a>
              </>
            )}
            {tags?.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <ul class="meta-tags">
                  {tags.slice(0, 3).map((tag) => (
                    <li>
                      <a href={`/tags/${slugifyTag(tag)}/`} class="meta-tag">{tag}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}

        <div class="page-actions">
          <slot name="actions" />
        </div>
      </div>

      <div class="page-head-right">
        <slot name="rightContent" />
      </div>
    </div>
  </div>
</header>

<style>
  .page-head { background: var(--paper); }
  .page-head-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(1.2rem, 4vw, 2rem) 1.4rem clamp(0.5rem, 2vw, 1rem);
  }
  .page-head-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .page-head-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  }
  .page-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 7vw, 2.9rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--ink);
    margin: 0;
  }
  .page-sub {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 34em;
  }
  .page-meta {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
  }
  .meta-link { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .meta-link:hover { color: var(--clay); border-color: var(--clay); }
  .meta-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .meta-tag {
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    background: rgba(46,107,94,0.08);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.72rem;
  }
  .meta-tag:hover { background: var(--accent); color: #fff; }
  .page-actions:empty { display: none; }
  .page-actions { margin-top: 1rem; }
</style>
