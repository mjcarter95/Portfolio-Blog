---
import "../styles/tailwind.css";
import "../styles/katex.css";
import SEO from "@/components/SEO.astro";

const {
  title = "Matthew Carter",
  description = "Matthew Carter is a researcher at the University of Liverpool combining artificial intelligence, Bayesian inference, and high-performance computing.",
  image = "/images/seo/og_card.png",
} = Astro.props;

const isHome = Astro.url.pathname === "/";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} image={image} />
  </head>

  <body>
    {!isHome && (
      <div class="home-link-wrap">
        <a href="/" class="home-link">← Home</a>
      </div>
    )}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .home-link-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 3.5rem) 1.4rem 0;
  }
  .home-link {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color .18s, border-color .18s;
  }
  .home-link:hover {
    color: var(--clay);
    border-color: var(--clay);
  }
</style>
